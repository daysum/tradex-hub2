# tradex 环境变量配置模板
# 复制为 .env 并根据需要修改，不配置也可正常运行（使用默认值）

# ── 数据源 ──────────────────────────────────────────────
# AKShare 请求超时时间（秒）
AKSHARE_TIMEOUT=30
# 腾讯行情接口超时时间（秒）
TENCENT_TIMEOUT=10
# 通达信服务器地址，auto 表示自动选择最优
ELTDX_SERVER=auto

# ── 东财防封客户端（anti_ban_client）────────────────────
# 请求最小间隔（秒），默认 1.0
EM_RATE_LIMIT_INTERVAL=1.0
# 随机抖动范围（秒），默认 0.1~0.5
EM_JITTER_MIN=0.1
EM_JITTER_MAX=0.5
# 限流/网络异常时的最大重试次数（指数退避 1s、2s、4s），默认 3
EM_MAX_RETRY=3

# ── 东财主机镜像降级（v3.3.21）────────────────────────────
# 东财节点故障是按主机（甚至按路由）发生的：主源一挂，依赖它的数据源全废，
# 而镜像明明可用。开启后 em_get 会自动切到镜像主机。
# 是否启用镜像降级，默认 1（设 0/false 关闭）
EM_HOST_MIRROR=1
# push2 的镜像主机，默认 push2delay.eastmoney.com（数据延迟几分钟，作为降级可接受）
EM_PUSH2_MIRROR=push2delay.eastmoney.com
# 镜像成功后的静默期（秒）：期间直接走镜像，不再白撞死主机。默认 300
EM_MIRROR_COOLDOWN=300
# 失败熔断冷却（秒）：某 (主机,路径) 主机级失败后，期间立即返回 None 让调用方走备源，
# 不再白跑满 EM_MAX_RETRY 次退避。默认 60；设 0 关闭熔断
EM_DEAD_HOST_COOLDOWN=60

# ── 腾讯防封客户端（qt.gtimg.cn）────────────────────────
# 腾讯风控远比东财宽松，但批量拉全市场会产生数十个连续请求，仍需节流
# 请求最小间隔（秒），默认 0.15
TENCENT_RATE_LIMIT_INTERVAL=0.15
# 随机抖动范围（秒），默认 0.05~0.15
TENCENT_JITTER_MIN=0.05
TENCENT_JITTER_MAX=0.15
# 最大重试次数，默认 2（腾讯是兜底源，重试过多会拉长 worst case）
TENCENT_MAX_RETRY=2

# ── 第二梯队防封客户端（同花顺 / 财联社 / 巨潮 / 新浪 / 问财）──
# 这些源风控远松于东财，但批量取数时仍需节流。各源独立节流器，
# 互不影响（低风险源不会被东财的 1.0s 间隔拖慢）。
# 指纹伪装版本，默认 chrome120
TIER2_IMPERSONATE=chrome120

# 同花顺 10jqka.com.cn / data.hexin.cn（热榜/涨停揭秘/涨跌分布/一致预期/北向）
THS_RATE_LIMIT_INTERVAL=0.25
THS_MAX_RETRY=2

# 财联社 cls.cn（7×24 电报）
CLS_RATE_LIMIT_INTERVAL=0.30

# 巨潮 cninfo.com.cn（官方公告）
# 注意：巨潮 WAF 封禁常见浏览器指纹（chrome120/124 实测 403），
# 该源在代码中固定走 NO_IMPERSONATE（关闭指纹伪装），此变量只控节流间隔。
CNINFO_RATE_LIMIT_INTERVAL=0.30

# 新浪财经 feed.mix.sina.com.cn（滚动新闻）
SINA_RATE_LIMIT_INTERVAL=0.25

# 问财 iwencai OpenAPI（需 IWENCAI_API_KEY；付费接口，失败多为配额/鉴权问题）
WENCAI_RATE_LIMIT_INTERVAL=0.50
WENCAI_MAX_RETRY=1

# ── 智能路由 ────────────────────────────────────────────
# 健康检查间隔（秒）
ROUTER_HEALTH_CHECK_INTERVAL=60
# 数据源最低健康评分，低于此值不再选中
ROUTER_MIN_SCORE=20.0
# 定时恢复评分的增量
ROUTER_RECOVERY_AMOUNT=10.0

# ── MCP 服务 ────────────────────────────────────────────
# MCP 传输模式：stdio | sse | http
MCP_TRANSPORT=stdio
# MCP HTTP 网关监听地址：默认 0.0.0.0（云/容器形态，与代理无关；数据源流量始终直连）。
# 仅本机调试可改 localhost。注意本机 Clash 代理(127.0.0.1:7897)只用于 GitHub，勿作服务地址。
MCP_HOST=0.0.0.0
# MCP HTTP/SSE 模式监听端口
MCP_PORT=8000
# HTTP Host 校验白名单：默认空=仅本机回环可连；绑 0.0.0.0 对外部署填目标 IP/域名，* = 全放行(仅可信内网)
MCP_ALLOWED_HOSTS=

# ── 缓存 ────────────────────────────────────────────────
# 内存缓存最大条目数，0 表示无限
CACHE_MAX_SIZE=5000
# 文件缓存目录路径
CACHE_FILE_DIR=.cache
# 是否启用文件缓存
CACHE_FILE_ENABLED=true

# ── 技术分析 ────────────────────────────────────────────
# 技术指标计算回溯天数
INDICATOR_LOOKBACK_DAYS=400
# 筹码分布直方图分箱数
CHIP_DISTRIBUTION_BINS=50

# ── 日志 ────────────────────────────────────────────────
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志文件目录
LOG_DIR=logs
